{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "millforge/schemas/spec.schema.json",
  "title": "Millforge Task Spec",
  "description": "§08-CONTRACT spec 结构化：NMH 锁定时的强制字段。",
  "type": "object",
  "required": ["task_id", "goal", "acceptance", "out_of_scope", "decision_class"],
  "properties": {
    "task_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": ["string", "null"] },
    "loop_id": { "type": ["string", "null"], "description": "所属 loop（§10）；null = 普通 task" },
    "iteration_index": { "type": ["integer", "null"], "minimum": 0, "description": "loop 内迭代序号（普通 task 为 null）" },
    "goal": { "type": "string", "minLength": 5, "description": "一句话目标（非过程描述）" },
    "acceptance": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "check", "pass_criteria"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "check": { "type": "string", "description": "检查方式（命令/审查项/谓词）" },
          "pass_criteria": { "type": "string", "description": "通过标准（可机器判定优先）" }
        }
      }
    },
    "out_of_scope": { "type": "array", "items": { "type": "string" }, "description": "显式排除项" },
    "decision_class": { "type": "string", "enum": ["R1", "R2", "R3", "R4", "R5", "R6"], "description": "Leader 填、人锁（§03-5 误分类走 decision_class_v2）" },
    "decision_class_v2": { "type": ["string", "null"], "enum": ["R1", "R2", "R3", "R4", "R5", "R6", null], "description": "B-10 重分类新记录（不覆盖原值）" },
    "contract_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ref"],
        "properties": {
          "ref": { "type": "string" },
          "pinned_fingerprint": { "type": "string", "pattern": "^contract:\\d+\\.\\d+\\.\\d+:[0-9a-f]{8}$" }
        }
      }
    },
    "critical_delivery": { "type": "boolean", "default": false, "description": "MC-1 多 critic 启用条件之一（人锁）" },
    "context_refs": { "type": "array", "items": { "type": "string" }, "description": "CAP-SPAWN context_refs（X1 唯一输入面）" },
    "deliver_to": { "type": "string", "description": "交付位置（三要素之一）" },
    "protocol_version": { "type": "string" }
  }
}
