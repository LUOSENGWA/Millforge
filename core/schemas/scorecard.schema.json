{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "millforge/schemas/scorecard.schema.json",
  "title": "Millforge NMA Scorecard",
  "description": "§05-NMA Checklist 验票：三要素（具体命令/预期结果/执行者标记）。B-6 超时维持 spec 时 critic 仍必须出评分卡。",
  "type": "object",
  "required": ["task_id", "reviewer", "items", "verdict"],
  "properties": {
    "task_id": { "type": "string" },
    "reviewer": { "type": "string", "description": "审核方 ≠ 被审核方" },
    "mode": { "type": "string", "enum": ["checklist", "peer-review"] },
    "items": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "what", "command", "expected", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^[CR]\\d+$", "description": "C=checklist / R=同行审查条目" },
          "what": { "type": "string" },
          "command": { "type": "string", "description": "可复制执行（不可执行标 ❌ 注明原因）" },
          "expected": { "type": "string", "description": "明确通过标准（不是'看起来对'）" },
          "status": { "type": "string", "enum": ["open", "pass", "fail", "unverifiable"] },
          "severity": { "type": "string", "enum": ["blocking", "suggestion", "question"] },
          "evidence": { "type": ["string", "null"], "description": "🟢 项必须贴命令输出原文（截断可，伪造不可）" },
          "executed_by": { "type": ["string", "null"], "enum": ["subject", "reviewer", null], "description": "🟢=被审核方 🔵=审核方 ❌=不可执行" },
          "reason": { "type": ["string", "null"], "description": "每个锁定/驳回必附一句话理由（无理由=黑箱=协议违规）" }
        }
      }
    },
    "verdict": { "type": "string", "enum": ["pass", "reject", "escalate"] },
    "dissent": { "type": ["string", "null"], "description": "B-6 超时维持 spec 时必填（critic 记 dissent 且仍出评分卡）" },
    "critic_model_family": { "type": ["string", "null"], "description": "MC-4：多 critic 时记录模型族（≥2 族约束）" },
    "reviewed_at": { "type": "string" }
  }
}
