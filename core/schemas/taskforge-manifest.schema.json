{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://millforge.dev/schemas/taskforge-manifest.schema.json",
  "title": "TaskForge manifest",
  "type": "object",
  "required": [
    "schema",
    "id",
    "version",
    "protocol_version",
    "kind",
    "entrypoint",
    "capabilities",
    "requires"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": 1
    },
    "id": {
      "const": "taskforge"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
    },
    "protocol_version": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "kind": {
      "const": "runner"
    },
    "entrypoint": {
      "type": "object",
      "required": [
        "command"
      ],
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "chat_refs",
          "checkpoints",
          "iteration_lease",
          "kick",
          "misfire_once",
          "occurrence",
          "outbox",
          "recovery",
          "rollback",
          "tasks",
          "timeline",
          "wait_for_change",
          "work_schema"
        ]
      }
    },
    "requires": {
      "type": "object",
      "required": [
        "agentteams",
        "contracts",
        "work_schema"
      ],
      "additionalProperties": false,
      "properties": {
        "agentteams": {
          "type": "string"
        },
        "contracts": {
          "type": "string"
        },
        "tool_schema": {
          "type": "string"
        },
        "millforge": {
          "type": "string"
        },
        "work_schema": {
          "type": "string"
        },
        "storage": {
          "type": "string"
        },
        "memory": {
          "type": "string"
        }
      }
    },
    "endpoints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "health": {
          "type": "string"
        },
        "handshake": {
          "type": "string"
        },
        "api": {
          "type": "string"
        },
        "ready": {
          "type": "string"
        }
      }
    },
    "compat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_controller": {
          "type": "string"
        },
        "max_controller": {
          "type": "string"
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commit": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        }
      }
    }
  }
}
