{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "millforge/schemas/contract_snapshot.schema.json",
  "title": "Millforge Contract Snapshot",
  "description": "C-2：R6 回答必带。S5 重放防护：task_id + checked_at 绑定，使用前验证匹配且在有效期内。",
  "type": "object",
  "required": ["task_id", "contract_ref", "pinned_fingerprint", "checked_at"],
  "additionalProperties": false,
  "properties": {
    "task_id": { "type": "string", "minLength": 1 },
    "contract_ref": { "type": "string", "minLength": 1 },
    "pinned_fingerprint": { "type": "string", "pattern": "^contract:\\d+\\.\\d+\\.\\d+:[0-9a-f]{8}$" },
    "checked_at": { "type": "string" },
    "valid_for_hours": { "type": "number", "minimum": 1, "default": 72, "description": "有效期（绑定层声明窗口）" },
    "note": { "type": ["string", "null"] }
  }
}
